local function findNearestInjuredPlayer(maxDist)
    maxDist = maxDist or 20
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local nearest = nil
    local nearestDist = maxDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ch = p.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and hum.Health < hum.MaxHealth then
                local isExp = p:FindFirstChild("Experiment")
                if not (isExp and isExp.Value == true) then
                    local dist = (myHRP.Position - hrp.Position).Magnitude
                    if dist < nearestDist then nearestDist = dist; nearest = p end
                end
            end
        end
    end
    return nearest
end
local function healTargetInstant(target)
    local ev = getHealingEvent()
    if not ev or not target then return false end
    pcall(function() ev:FireServer("StartVisuals", target) end)
    task.spawn(function()
        for i = 1, 6 do
            pcall(function() ev:FireServer("HealTick", target) end)
            task.wait(0.1)
        end
        pcall(function() ev:FireServer("GiveSpeedBoost") end)
        pcall(function() ev:FireServer("StartCooldown") end)
    end)
    return true
end
local function healNearest() return healTargetInstant(findNearestInjuredPlayer(100)) end
local function healSelf()
    local ev = getHealingEvent()
    if not ev then return false end
    pcall(function() ev:FireServer("StartVisuals", LocalPlayer) end)
    task.spawn(function()
