            TweenService:Create(ball, info, { Position = UDim2.new(0, 27, 0.5, -11), BackgroundColor3 = C.accent, Size = UDim2.new(0, 24, 0, 24) }):Play()
            TweenService:Create(toggleBg, info, { BackgroundColor3 = C.accent4 }):Play()
