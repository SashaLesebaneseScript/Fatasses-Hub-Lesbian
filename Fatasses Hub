-- Auto Start (activa el ProximityPrompt del NPC más cercano)
local function getNPCsConPrompt()
    local lista = {}
    local miChar = LocalPlayer.Character
    local myPos = miChar and miChar:FindFirstChild("HumanoidRootPart") and miChar.HumanoidRootPart.Position
    if not myPos then return lista end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local pp = obj:FindFirstChild("ProximityPrompt", true)
            if pp then
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                if hrp then
                    table.insert(lista, {model = obj, prompt = pp, dist = (myPos - hrp.Position).Magnitude})
                end
            end
        end
    end
    table.sort(lista, function(a, b) return a.dist < b.dist end)
    return lista
end

local autoStartThread = nil
local function iniciarAutoStart()
    if autoStartThread then return end
    autoStartThread = task.spawn(function()
        while autoStartActivo do
            if not tareaActual then
                local lista = getNPCsConPrompt()
                if #lista > 0 then
                    local pp = lista[1].prompt
                    pcall(function()
                        if not pp.Enabled then pp.Enabled = true end
                        if firesignal and pp.PromptButtonHoldBegan then
                            firesignal(pp.PromptButtonHoldBegan)
                            firesignal(pp.PromptButtonHoldEnded)
                        elseif firesignal and pp.Triggered then
                            firesignal(pp.Triggered)
                        end
                        if pp.HoldDuration > 0 then
                            -- Simular hold completo con input
                            keypress(Enum.KeyCode.E)
                            task.wait(pp.HoldDuration + 0.05)
                            keyrelease(Enum.KeyCode.E)
                        end
                    end)
                end
            end
            task.wait(0.5)
        end
        autoStartThread = nil
    end)
end
local function detenerAutoStart() autoStartActivo = false; autoStartThread = nil end

