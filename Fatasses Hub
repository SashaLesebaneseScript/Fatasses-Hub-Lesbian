-- INF STAMINA
local SPEED_SPRINT = 30
local SPEED_WALK = 10
local SPEED_NO_MAP = 16
local STAM_FAKE = 100000
local sprintHeld = false
local sprintBtnEnlazado = nil
local infStaminaConn = nil
local humHookeado = nil

local function hayMapa()
    return Workspace:FindFirstChild("Map1") ~= nil or Workspace:FindFirstChild("Map2") ~= nil
end
local function getTargetSpeed()
    if not hayMapa() then return SPEED_NO_MAP end
    if sprintHeld then return SPEED_SPRINT end
    return SPEED_WALK
end
local function forzarStam()
    local ch = LocalPlayer.Character
    if not ch then return end
    for _, o in ipairs(ch:GetDescendants()) do
        if o:IsA("IntValue") or o:IsA("NumberValue") then
            local n = string.lower(o.Name)
            if n == "stam" or n == "stamina" then
                if o.Value < 1000 then pcall(function() o.Value = STAM_FAKE end) end
            end
        end
    end
end
local function instalarHook(hum)
    if not hum or hum == humHookeado then return end
    humHookeado = hum
    pcall(function()
        local mt = getrawmetatable(hum)
        if not mt then return end
        if setreadonly then setreadonly(mt, false) end
        local oldNI = mt.__newindex
        mt.__newindex = function(self, key, value)
            if key == "WalkSpeed" and self == hum and infStaminaActivo then
                local target = getTargetSpeed()
                if value ~= target then return oldNI(self, key, target) end
            end
            return oldNI(self, key, value)
        end
        if setreadonly then setreadonly(mt, true) end
    end)
end
local function aplicarUIStam()
    local sg = LocalPlayer.PlayerGui:FindFirstChild("SprintGui")
    if not sg then return end
    local txt = sg:FindFirstChild("StaminaText", true)
    if txt and txt:IsA("TextLabel") then
        if txt.Text ~= "Stamina: 🎃 Inf/67" then txt.Text = "Stamina: 🎃 Inf/67" end
        txt.TextColor3 = Color3.fromRGB(255, 150, 50)
    end
end
