local function renderTracers()
    if not espTracersActivo then
        for _, line in pairs(tracersCache) do if line.Parent then line.Visible = false end end
        return
    end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myFootPos = getFootPos(myChar)
    if not myFootPos then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local myScreen, myOnScreen = cam:WorldToViewportPoint(myFootPos)
    if not myOnScreen then
        for _, line in pairs(tracersCache) do if line.Parent then line.Visible = false end end
        return
    end
    local masAlto, alturaMax = nil, -math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local ok, tam = pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and tam and tam > alturaMax then alturaMax = tam; masAlto = p.Character end
            end
        end
    end
    local aliveChars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ch = p.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                aliveChars[ch] = true
                local footPos = getFootPos(ch)
                if footPos then
                    local screenPos, onScreen = cam:WorldToViewportPoint(footPos)
                    if onScreen then
                        local line = tracersCache[ch]
                        if not line or not line.Parent then
                            line = Instance.new("Frame")
                            line.BorderSizePixel = 0
                            line.ZIndex = 998
                            line.AnchorPoint = Vector2.new(0.5, 0.5)
                            line.Parent = tracerGui
                            tracersCache[ch] = line
                        end
                        local dx = screenPos.X - myScreen.X
                        local dy = screenPos.Y - myScreen.Y
                        local length = math.sqrt(dx*dx + dy*dy)
                        local angle = math.deg(math.atan2(dy, dx))
                        line.Size = UDim2.new(0, length, 0, 2)
                        line.Position = UDim2.new(0, (myScreen.X + screenPos.X) / 2, 0, (myScreen.Y + screenPos.Y) / 2)
                        line.Rotation = angle
                        line.Visible = true
                        local isKiller = (ch == masAlto) or isPlayerKiller(p)
                        line.BackgroundColor3 = isKiller and Color3.fromRGB(255,30,60) or Color3.fromRGB(255,120,20)
                    else
                        local line = tracersCache[ch]
                        if line and line.Parent then line.Visible = false end
                    end
                end
            end
        end
    end
    for ch, line in pairs(tracersCache) do
        if not aliveChars[ch] or not ch.Parent then
            if line.Parent then line:Destroy() end
            tracersCache[ch] = nil
        end
    end
