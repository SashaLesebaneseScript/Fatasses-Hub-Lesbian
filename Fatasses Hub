local TIEMPO_AIM_ANTES_DISPARO = 0
local COOLDOWN_DISPARO = 0.6
local function contarScripts(modelo)
    if not modelo or not modelo:IsA("Model") then return 0 end
    local count = 0
    for _, hijo in ipairs(modelo:GetDescendants()) do
        if hijo:IsA("Script") or hijo:IsA("LocalScript") or hijo:IsA("ModuleScript") then count = count + 1 end
    end
    return count
end
local function encontrarKillerAutomatico()
    local mejorKiller = nil
    local mejorScore = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ch = p.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local numScripts = contarScripts(ch)
                local altura = ch:GetExtentsSize().Y
                if numScripts >= KILLER_SCRIPTS_THRESHOLD then
                    local score = 1000 + numScripts
                    if score > mejorScore then mejorScore = score; mejorKiller = ch end
                elseif altura > mejorScore then mejorScore = altura; mejorKiller = ch end
            end
        end
    end
    return mejorKiller
end
local function estaApuntando()
    local miChar = LocalPlayer.Character
    if not miChar then return false end
    return miChar:GetAttribute("IsAiming") == true
end
local function getTargetChest(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end
local function getPredictChestPos(char)
    if not char then return nil end
    local chest = getTargetChest(char)
    if not chest then return nil end
    local velocity = Vector3.new(0, 0, 0)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        velocity = hrp.AssemblyLinearVelocity
        if velocity.Magnitude < 0.1 then velocity = hrp.Velocity end
    end
    local predict = velocity * 0.12
    if predict.Magnitude > PREDICT_STUDS then predict = predict.Unit * PREDICT_STUDS end
    return chest.Position + predict
end
local function iniciarAimlock()
    if cameraConnection then return end
    cameraConnection = RunService.RenderStepped:Connect(function()
        if not aimlockOnAim then return end
        if not estaApuntando() then return end
        if not characterTarget or not characterTarget.Parent then characterTarget = encontrarKillerAutomatico() end
        if characterTarget and characterTarget.Parent then
            local aimPos = getPredictChestPos(characterTarget)
            if aimPos then workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, aimPos) end
        end
    end)
end
local function detenerAimlock() if cameraConnection then cameraConnection:Disconnect(); cameraConnection = nil end; characterTarget = nil end
local function buscarTriggerButton()
    local gui = LocalPlayer.PlayerGui:FindFirstChild("GunGui")
    if not gui then return nil end
    return gui:FindFirstChild("TriggerButton", true) or gui:FindFirstChild("Trigger", true) or gui:FindFirstChild("ShootButton", true)
end
local function dispararTrigger()
    local btn = buscarTriggerButton()
    if not btn then return false end
    if firesignal then pcall(firesignal, btn.MouseButton1Click); return true end
    pcall(function() btn:Activate() end)
    return false
end
local autoShootConn = nil
local function iniciarAutoShoot()
    if autoShootConn then return end
    aimStartTime = 0
    autoShootConn = RunService.RenderStepped:Connect(function()
        if not autoShootActivo then return end
        local miChar = LocalPlayer.Character
        if not miChar then aimStartTime = 0; return end
        if not estaApuntando() then aimStartTime = 0; return end
        if aimStartTime == 0 then aimStartTime = tick(); return end
        if tick() - aimStartTime < TIEMPO_AIM_ANTES_DISPARO then return end
        if tick() - ultimoDisparo < COOLDOWN_DISPARO then return end
        local killer = characterTarget or encontrarKillerAutomatico()
        if not killer or not killer.Parent then return end
        if tieneLineaDeVision(killer) then
            if dispararTrigger() then ultimoDisparo = tick(); aimStartTime = tick() end
        end
    end)
end
local function detenerAutoShoot() if autoShootConn then autoShootConn:Disconnect(); autoShootConn = nil end; aimStartTime = 0 end

